class newMeta {
    constructor() {}

    static MakeEntity(data) {
        let meta = new newMeta()
        meta.UpdateData(data)
        return meta
    }

    UpdateData(data) {
        this._data = {}
        for (var key in data) {
            this._data[key] = data[key]
        }
    }

    Data() {
        return this._data
    }

    Id() {
        return this._data.id
    }
}

global.Meta.newMeta = newMeta